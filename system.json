{
  "id": "magna",
  "title": "MAGNA",
  "description": "Système pour le jeu MAGNA",
  "version": "#{VERSION}#",
  "compatibility": {
    "minimum": "14",
    "verified": "14",
    "maximum": "14"
  },
  "authors": [
    {
      "name": "Khaali"
    }
  ],
  "esmodules": ["magna.mjs"],
  "styles": ["css/magna.css"],
  "documentTypes": {
    "Actor": {
      "pj": { "htmlFields": ["description", "equipement"] },
      "pnj": { "htmlFields": ["description", "equipement"] }
    },
    "Item": {
      "arme": { "htmlFields": ["description"] },
      "pouvoir": { "htmlFields": ["description"] }
    }
  },
  "packs": [],
  "languages": [
    {
      "lang": "fr",
      "name": "French",
      "path": "lang/fr.json"
    },
    {
      "lang": "en",
      "name": "English",
      "path": "lang/fr.json"
    }
  ],
  "flags": {
    "hotReload": {
      "extensions": ["css", "hbs", "json"],
      "paths": ["lang/", "assets/", "templates/", "css/"]
    }
  },
  "media": [
    {
      "type": "cover",
      "thumbnail": "systems/magna/assets/logo_magna.webp",
      "loop": false,
      "flags": {}
    },
    {
      "type": "setup",
      "loop": false,
      "thumbnail": "systems/magna/assets/logo_magna.webp",
      "flags": {}
    }
  ],
  "grid": {
    "distance": 1.5,
    "units": "m",
    "type": 0
  },
  "background": "systems/magna/assets/logo_magna.webp",
  "primaryTokenAttribute": "vitalite",
  "secondaryTokenAttribute": "mental",
  "initiative": "1d20 + @caracteristiques.agi.valeur",
  "url": "#{URL}#",
  "manifest": "#{MANIFEST}#",
  "download": "#{DOWNLOAD}#"
}
